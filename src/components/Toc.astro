---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** mobile: collapsible block above the article; desktop: sticky sidebar (≥1200px). */
  variant: 'mobile' | 'desktop';
}

const { variant } = Astro.props;
const items = Astro.props.headings.filter((h) => h.depth <= 3);
const minDepth = Math.min(...items.map((h) => h.depth));
---

{
  items.length >= 2 && variant === 'mobile' && (
      <details class="toc-mobile" data-toc>
        <summary>On this page</summary>
        <ol>
          {items.map((h) => (
            <li style={`--lvl: ${h.depth - minDepth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
  )
}
{
  items.length >= 2 && variant === 'desktop' && (
      <nav class="toc-desktop" aria-label="Table of contents" data-toc>
        <p class="kicker">On this page</p>
        <ol>
          {items.map((h) => (
            <li style={`--lvl: ${h.depth - minDepth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
  )
}

<style>
  /* One continuous guide line; nesting is shown by indenting the link text. */
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }

  a {
    display: block;
    padding: 0.28rem 0 0.28rem calc(0.85rem + var(--lvl) * 0.9rem);
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.4;
    transition: color 0.2s, border-color 0.2s;
  }

  a:hover {
    color: var(--fg);
  }

  a.active {
    color: var(--fg);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  .toc-mobile {
    margin: 0 0 2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .toc-mobile summary {
    cursor: pointer;
    font: 600 0.85rem var(--font-mono);
    color: var(--muted);
  }

  .toc-mobile ol {
    margin-top: 0.75rem;
  }

  .toc-desktop {
    display: none;
  }

  .toc-desktop .kicker {
    margin: 0 0 0.75rem;
  }

  @media (min-width: 1200px) {
    .toc-mobile {
      display: none;
    }

    .toc-desktop {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      max-height: calc(100vh - var(--header-h) - 4rem);
      overflow-y: auto;
    }
  }
</style>
