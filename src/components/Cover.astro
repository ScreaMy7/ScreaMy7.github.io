---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import GeneratedCover from './GeneratedCover.astro';

interface Props {
  title: string;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  /** Shared view-transition-name so the card cover morphs into the post header. */
  transition?: string;
  eager?: boolean;
  class?: string;
}

const { title, tags, cover, coverAlt, transition, eager = false, class: className } = Astro.props;
---

<div class:list={['cover', className]} style={transition ? `view-transition-name: ${transition}` : undefined}>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[480, 800, 1200]}
        sizes="(max-width: 720px) 100vw, 720px"
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <GeneratedCover title={title} tags={tags} />
    )
  }
</div>

<style>
  .cover {
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
