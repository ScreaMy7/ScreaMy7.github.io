---
import { tagSlug } from '../lib/content';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
