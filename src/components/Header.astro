---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container wide bar">
    <a class="brand" href="/">
      <span class="spark" aria-hidden="true">✦</span>
      <span>{SITE.handle}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"
        ></path>
      </svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </g>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
    view-transition-name: site-header;
  }

  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    margin-right: auto;
  }

  .spark {
    display: inline-block;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 1.2rem;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .brand:hover .spark {
    transform: rotate(180deg) scale(1.15);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s, background 0.2s;
  }

  nav a:hover {
    color: var(--fg);
    background: var(--surface);
  }

  nav a[aria-current='page'] {
    color: var(--fg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, transform 0.3s;
  }

  .theme-toggle:hover {
    color: var(--accent);
    transform: rotate(-20deg);
  }

  .sun {
    display: none;
  }

  :global([data-theme='dark']) .moon {
    display: none;
  }

  :global([data-theme='dark']) .sun {
    display: block;
  }

  @media (max-width: 560px) {
    .bar {
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: -0.8rem;
    }
  }
</style>
