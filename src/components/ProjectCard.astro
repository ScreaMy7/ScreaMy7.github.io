---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
---

<article class="project fx-card" data-tilt data-reveal style={`--d: ${delay}`}>
  <h3>
    {
      project.repo ? (
        <a href={project.repo} class="stretched">
          {project.name}
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ) : (
        project.name
      )
    }
  </h3>
  <p>{project.description}</p>
  <div class="foot">
    <ul class="stack">
      {project.stack.map((s) => <li>{s}</li>)}
    </ul>
    {
      project.links && (
        <span class="links">
          {project.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </span>
      )
    }
  </div>
</article>

<style>
  .project {
    padding: 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    isolation: isolate;
  }

  h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.25s;
  }

  .project:hover .arrow {
    transform: translate(3px, -3px);
  }

  p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
    flex: 1;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    font: 0.72rem var(--font-mono);
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
  }

  .links {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 0.75rem;
    font-size: 0.85rem;
  }
</style>
