---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
// Display face for headings. Ships 400 only, upright + italic — the italic
// carries the accent words (.grad-text), so both faces are needed.
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { DEFAULT_OG_IMAGE } from '../lib/content';
import { COVER_W, COVER_H } from '../lib/cover';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Use the wide container (cards grids, post page with TOC). */
  wide?: boolean;
  /** Share image path (1200×630 PNG). Defaults to the site-wide one. */
  image?: string;
  /** Article dates and tags, for og:type="article". */
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Keep the page out of search results (e.g. an empty listing). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  wide = false,
  image = DEFAULT_OG_IMAGE,
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} (${SITE.handle})`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#16191f" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(COVER_W)} />
    <meta property="og:image:height" content={String(COVER_H)} />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={new URL('/about/', Astro.site).href} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />

    <!-- External (not inline) so the CSP can keep script-src 'self'. Runs before paint to avoid a theme flash. -->
    <script is:inline src="/js/theme-init.js"></script>
    <script is:inline src="/js/site.js" defer></script>
    <slot name="head" />
  </head>
  <body>
    <a class="visually-hidden skip-link" href="#main">Skip to content</a>
    <slot name="top" />
    <Header />
    <main id="main" class:list={['container', { wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
