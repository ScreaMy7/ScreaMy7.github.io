---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPublished, readingMinutes } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublished('research');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { vendor, product, affected, fixed, cve, severity, status } = entry.data;
---

<Post
  section="research"
  id={entry.id}
  {...entry.data}
  minutes={readingMinutes(entry.body)}
  headings={headings}
  advisory={{ vendor, product, affected, fixed, cve, severity, status }}
>
  <Content />
</Post>
