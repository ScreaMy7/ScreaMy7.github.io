---
import Base from '../layouts/Base.astro';
import { projects, contributions } from '../data/projects';
---

<Base title="Projects" description="Security tools and open-source work by Aadarsh Anand." wide>
  <header class="page-head">
    <p class="kicker" data-reveal>Projects</p>
    <h1 data-reveal style="--d: 1">Things I've <span class="grad-text">built</span></h1>
    <p class="lede" data-reveal style="--d: 2">
      Tools for mobile security, reverse engineering and fuzzing. Most came out of a job that was
      too slow to do by hand twice.
    </p>
  </header>

  <div class="section-head" data-reveal>
    <h2><span class="num" aria-hidden="true">01</span>Tools</h2>
    <span class="count mono">{projects.length} projects</span>
  </div>

  <div class="rows">
    {
      projects.map((p, i) => (
        <article class="row" data-reveal style={`--d: ${i % 2}`}>
          <span class="n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="body">
            <h3>
              {p.repo ? (
                <a href={p.repo}>
                  {p.name} <span class="arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                p.name
              )}
            </h3>
            <p class="desc">{p.description}</p>
            <div class="foot">
              <ul class="stack">
                {p.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              {p.links && (
                <span class="links">
                  {p.links.map((l) => (
                    <a href={l.href}>{l.label}</a>
                  ))}
                </span>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="section-head" data-reveal>
    <h2><span class="num" aria-hidden="true">02</span>Contributions</h2>
  </div>

  <div class="rows">
    {
      contributions.map((c, i) => (
        <article class="row" data-reveal style={`--d: ${i % 2}`}>
          <span class="n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="body">
            <h3>
              <a href={c.href}>
                {c.name} <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </h3>
            <p class="desc">{c.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: 1rem;
  }

  .page-head h1 {
    margin: 0.4rem 0 0.9rem;
  }

  .lede {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .count {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .rows {
    border-bottom: 1px solid var(--border);
  }

  .row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0 1.25rem;
    padding: 1.9rem 0;
    border-top: 1px solid var(--border);
    align-items: start;
  }

  .n {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding-top: 0.45rem;
  }

  .row:hover .n {
    color: var(--accent);
  }

  .body {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  .row:hover h3 a {
    color: var(--accent);
  }

  .arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.25s;
  }

  .row:hover .arrow {
    transform: translate(3px, -3px);
  }

  .desc {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
    max-width: 46rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    font: 0.72rem var(--font-mono);
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 12%, transparent);
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
  }

  .links {
    display: flex;
    gap: 0.75rem;
    font-size: 0.85rem;
  }
</style>
