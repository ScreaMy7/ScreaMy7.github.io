---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPublished, readingMinutes } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublished('notes');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Post section="notes" id={entry.id} {...entry.data} minutes={readingMinutes(entry.body)} headings={headings}>
  <Content />
</Post>
