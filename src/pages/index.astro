---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getAllItems, getItems } from '../lib/content';
import { projects } from '../data/projects';
import { SITE, SOCIALS } from '../consts';

const posts = (await getAllItems()).slice(0, 5);
const blogCount = (await getItems('blog')).length;
const noteCount = (await getItems('notes')).length;
// Two-up grid: feature the newest post (full-width) only when the count is odd,
// so the rest fill complete rows with no lonely trailing card.
const featureFirst = posts.length % 2 === 1;
const featured = projects.filter((p) => p.featured);

const stats = [
  { value: '200+', label: 'penetration tests' },
  { value: '$20k+', label: 'in bug bounties' },
  { value: 'OWASP', label: 'MASTG contributor' },
];
const home = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: `${SITE.title} (${SITE.handle})`, url: home, description: SITE.description },
    {
      '@type': 'Person',
      name: SITE.title,
      alternateName: SITE.handle,
      url: home,
      jobTitle: 'Security researcher',
      sameAs: SOCIALS.map((s) => s.href),
    },
  ],
};
// Grouped by how much of my week each one actually takes, not by self-grading.
const focus = [
  {
    tier: 'Daily',
    items: ['Android app assessment', 'Frida instrumentation', 'jadx + Ghidra', 'Burp Suite'],
  },
  {
    tier: 'Deep work',
    items: ['native .so reverse engineering', 'AFL++ / JNI fuzzing', 'Semgrep + Androguard rules'],
  },
  {
    tier: 'Currently building',
    items: ['LLM agents for pentest workflows', 'fuzzing pipelines', 'benchmarks'],
  },
];

const recognition = [
  { label: 'OWASP MASTG', detail: 'test cases on code security, SSL pinning, IPC and crypto flaws' },
  { label: 'Hall of Fame', detail: 'Accenture, the United Nations, Palo Alto Networks' },
  { label: 'H@cktivityCon 2021 CTF', detail: 'top 60 globally, web and mobile' },
  { label: 'Nuclei Templates', detail: 'CVE detection templates for the community library' },
];

const next = [
  { href: '/blog/', label: 'Blog', detail: 'Long-form writeups: methodology, reverse engineering, fuzzing', meta: `${blogCount} ${blogCount === 1 ? 'post' : 'posts'}` },
  { href: '/notes/', label: 'Notes', detail: 'Short pieces on how I work — agents, tooling, workflow', meta: `${noteCount} ${noteCount === 1 ? 'note' : 'notes'}` },
  { href: '/projects/', label: 'Projects', detail: 'Tools I maintain: soxtract, afl-android-emulator-kernel, CLI-MD', meta: `${projects.length} projects` },
  { href: '/about/', label: 'About', detail: 'Background, work at Appknox, bug bounty record', meta: 'Who I am' },
];
---

<Base wide>
  <script is:inline slot="head" src="/js/hero.js" defer></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <canvas data-hero-canvas aria-hidden="true"></canvas>
    <div class="hero-inner">
      <p class="kicker" data-reveal>Security researcher · {SITE.handle}</p>
      <h1 data-reveal style="--d: 1">
        Hi, I'm <span class="grad-text">Aadarsh</span>.<br />
        I break Android apps and build the tools to do it.
      </h1>
      <p class="lede" data-reveal style="--d: 2">
        Reverse engineering, native code and fuzzing. Security Researcher at Appknox and bug bounty
        hunter.
      </p>
      <div class="cta" data-reveal style="--d: 3">
        <a class="btn primary" href="/blog/">Read the blog <span aria-hidden="true">→</span></a>
        <a class="btn" href="/projects/">See projects</a>
      </div>
    </div>
  </section>

  <ul class="stats">
    {
      stats.map((s, i) => (
        <li data-reveal style={`--d: ${i}`}>
          <span class="value grad-text">{s.value}</span>
          <span class="label">{s.label}</span>
        </li>
      ))
    }
  </ul>

  <div class="section-head" data-reveal>
    <h2><span class="num mono" aria-hidden="true">01</span>Latest writing</h2>
    <a href="/blog/">All posts →</a>
  </div>
  {
    posts.length === 0 ? (
      <p class="empty">First posts coming soon.</p>
    ) : (
      <div class="posts-grid">
        {posts.map((item, i) => (
          <PostCard item={item} featured={featureFirst && i === 0} delay={i % 2} />
        ))}
      </div>
    )
  }

  <div class="section-head" data-reveal>
    <h2><span class="num mono" aria-hidden="true">02</span>Things I've built</h2>
    <a href="/projects/">All projects →</a>
  </div>
  <div class="grid">
    {featured.map((p, i) => <ProjectCard project={p} delay={i % 2} />)}
  </div>

  <div class="section-head" data-reveal>
    <h2><span class="num mono" aria-hidden="true">03</span>What I work on</h2>
  </div>
  <div class="split">
    <div class="tiers" data-reveal>
      {
        focus.map((group) => (
          <section class="tier">
            <h3 class="mono">{group.tier}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <div class="recognition" data-reveal style="--d: 1">
      <h3 class="mono">Recognition</h3>
      <dl>
        {
          recognition.map((r) => (
            <>
              <dt>{r.label}</dt>
              <dd>{r.detail}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="section-head" data-reveal>
    <h2><span class="num mono" aria-hidden="true">04</span>Where to next</h2>
  </div>
  <ul class="next">
    {
      next.map((n, i) => (
        <li class="fx-card" data-reveal style={`--d: ${i % 2}`}>
          <a href={n.href}>
            <span class="meta mono">{n.meta}</span>
            <span class="label">
              {n.label} <span aria-hidden="true">→</span>
            </span>
            <span class="detail">{n.detail}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .hero {
    position: relative;
    margin-top: -3rem;
    padding: clamp(4rem, 12vh, 8rem) 0 4rem;
    isolation: isolate;
  }

  canvas {
    position: absolute;
    inset: 0 -16px;
    width: calc(100% + 32px);
    height: 100%;
    z-index: -1;
    mask-image: radial-gradient(ellipse 75% 70% at 60% 45%, #000 35%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 60% 45%, #000 35%, transparent 80%);
  }

  .hero-inner {
    max-width: 50rem;
  }

  .hero h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0.6rem 0 1.25rem;
  }

  .lede {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: var(--muted);
    max-width: 38rem;
    margin: 0 0 2rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  /* "What I work on": tiers on the left, recognition on the right. */
  .split {
    display: grid;
    gap: 1.25rem;
  }

  .tiers,
  .recognition {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1.5rem;
  }

  .tiers {
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .tiers h3,
  .recognition h3 {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  .tier ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tier li {
    font: 0.82rem var(--font-mono);
    color: var(--fg);
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  /* Later tiers read as lighter commitments than the first. */
  .tier:not(:first-child) li {
    color: var(--muted);
    background: transparent;
  }

  .recognition dl {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .recognition dt {
    font-weight: 600;
    font-size: 0.97rem;
  }

  .recognition dd {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* "Where to next": the routing block for a first-time visitor. */
  .next {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .next li {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .next a {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem;
    height: 100%;
    color: var(--fg);
    text-decoration: none;
  }

  .next .meta {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .next .label {
    font: 400 1.4rem var(--font-display);
    letter-spacing: -0.01em;
  }

  .next li:hover .label {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .next .detail {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (min-width: 880px) {
    .split {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats li {
    display: grid;
    gap: 0.1rem;
  }

  .value {
    font: 400 2.6rem var(--font-display);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .label {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Blog posts: wider cards (two-up), with the featured post spanning the row. */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: 1.25rem;
  }

  .posts-grid > :global(.featured) {
    grid-column: 1 / -1;
  }

  /* Project cards: tighter, three-up. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }
</style>
